## transform selected numeric variables from character 
## to numeric values
CharacterToNumeric <- function(dat,
                               variable_names) {
  for (j in variable_names) {
    dat[, j] <- as.numeric(dat[, j])
  }
  
  return(dat)
}


## transform selected date variables from character 
## to datetime values
CharacterToDatetime <- function(dat,
                                variable_names) {
  for (j in variable_names) {
    dat[, j] <- lubridate::as_datetime(dat[, j])
  }
  
  return(dat)
}


Create0vsNACategories <- function(dat,
                                  variable_name) {
  n <- nrow(dat)
  x <- rep(NA, n)
  idx_0 <- which(dat[, variable_name] == 0)
  idx_NA <- which(is.na(dat[, variable_name]))
  idx_not_0_nor_NA <- which(dat[, variable_name] != 0 & 
                              !is.na(dat[, variable_name]))
  x[idx_0] <- "0"
  x[idx_NA] <- "NA"
  x[idx_not_0_nor_NA] <- "not_0_nor_NA"
  
  return(x)
}


MarginalBarplot <- function(dat, var_name) {
  x <- Create0vsNACategories(dat, var_name)
  barplot(table(x), main = var_name)
}


Mosaicplot3 <- function(dat, 
                        var_name_1, 
                        var_name_2,
                        cex.axis = 1) {
  
  aux1 <- Create0vsNACategories(dat, var_name_1)
  aux2 <- Create0vsNACategories(dat, var_name_2) 
  mosaicplot(aux2 ~ aux1, 
             las = 2,
             main = "",
             ylab = var_name_1,
             xlab = var_name_2,
             cex.axis = cex.axis,
             color = TRUE)
}


Mosaicplot2 <- function(dat, 
                        var_name_1, 
                        var_name_2,
                        cex.axis = 1) {
  aux1 <- dat[, var_name_1]
  aux1_num <- as.numeric(aux1)
  aux1[is.na(aux1_num) | aux1_num == 0] <- "0_or_NA"
  aux1[aux1_num != 0 & !is.na(aux1_num)] <- "not_0_nor_NA"
  ####
  aux2 <- dat[, var_name_2]
  aux2_num <- as.numeric(aux2)
  aux2[is.na(aux2_num) | aux2_num == 0] <- "0_or_NA"
  aux2[aux2_num != 0 & !is.na(aux2_num)] <- "not_0_nor_NA"
  ####
  mosaicplot(aux2 ~ aux1, 
             las = 2,
             main = "",
             ylab = var_name_1,
             xlab = var_name_2,
             cex.axis = cex.axis,
             color = TRUE)
}


GetMissingDataProportion <- function(dat, variable_names) {
  n_missing <- apply(dat[, variable_names], 2, function(x) sum(is.na(x)))
  prop_missing <- n_missing/nrow(dat)
  
  return(prop_missing)
}


GetParticipantDeviceInfo <- function(dat_device, dat_activity) {
  ## create table of participant by device type 
  tb <- table(dat_device$ParticipantIdentifier, dat_device$Device)
  tb <- as.data.frame.matrix(tb)
  tmp <- apply(tb, 1, function(x) sum(x == 0))
  
  ## find participants with one single device
  ids_single <- names(which(tmp == (ncol(tb) - 1)))
  
  ## find participants with multiple devices
  ids_multiple <- names(which(tmp < (ncol(tb) - 1)))
  
  ## copy the Device variable to a new Device2 variable and
  ## assign category "multiple_devices" to any participant
  ## that has multiple devices
  dat_device$Device2 <- dat_device$Device
  dat_device$Device2[dat_device$ParticipantIdentifier %in% ids_multiple] <- "multiple_devices" 
  
  ## create data frame of participants and respective devices
  ids <- unique(dat_device$ParticipantIdentifier)
  nids <- length(ids)
  dat <- data.frame(matrix(NA, nids, 2))
  colnames(dat) <- c("ParticipantIdentifier", "Device")
  dat[, 1] <- ids
  for (i in seq(nids)) {
    aux <- dat_device[dat_device$ParticipantIdentifier == ids[i],]
    dat[i, 2] <- aux[1, "Device2"]
  }
  
  ## participants that don't have device information
  ParticipantIdentifier <- setdiff(unique(dat_activity$ParticipantIdentifier), 
                                   dat$ParticipantIdentifier)
  Device <- "no_device_info"
  dat_no_info <- data.frame(ParticipantIdentifier, Device)
  
  ## append the data
  dat <- rbind(dat, dat_no_info)
  
  return(dat)
}


